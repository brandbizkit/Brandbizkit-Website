# --- Admin CMS ---
# Key for signing into /admin
ADMIN_KEY=change-me

# --- Agent publishing API ---
# x-api-key for POST /api/agent/* (content, videos/transcripts, mentions).
# Leave unset to disable the agent API entirely.
AGENT_API_KEY=change-me-too

# --- GoHighLevel CRM sync (optional) ---
# Option A: inbound webhook URL from a GHL workflow
GHL_WEBHOOK_URL=
# Option B: API v2 private integration token + location
GHL_API_KEY=
GHL_LOCATION_ID=

# --- Supabase (leads + newsletter subscribers) ---
# Project Settings -> API. SERVICE_ROLE key is server-only, never expose it
# to the browser or commit it. Run supabase/schema.sql once before use.
SUPABASE_URL=https://rukzmuzkzcvxxsctpbqh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
